# Build output
dist/

# Reference copies of upstream sources, fetched only to cross-validate the
# cookie encoder. Not part of this project.
ref/

# Local credentials — never commit
accounts.txt
qwen2api.conf

# Go
*.test
*.out
*.exe

# Locally unpacked Go toolchain. Normally absent: the release binary is built by
# GitHub Actions (.github/workflows/build.yml), so a working tree with no Go
# installed is the expected state. Ignored in case one is unpacked for local
# debugging.
.toolchain/

# Session transcript (working notes, not part of the project)
context_qwenproxy.txt

# Scratch output from the image-generation workbench (not part of the project)
dsh-image-gen/

# Temporary credential bridge used when pushing over the SOCKS5 proxy
.git-cred-shim.sh
