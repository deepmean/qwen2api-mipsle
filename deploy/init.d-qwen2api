#!/bin/sh /etc/rc.common
# qwen2api — Qwen web -> OpenAI-compatible gateway (Go, static mipsle build).
#
# Binary:  /opt/qwen2api/qwen2api
# Config:  /opt/qwen2api/qwen2api.conf   (API_KEY / SERVICE_PORT, chmod 600)
# Creds:   /opt/qwen2api/accounts.txt    (email:password lines, chmod 600)
# Manage:  /etc/init.d/qwen2api start|stop|restart|status ; logread -e qwen2api
#
# Ported from github.com/deepmean/Qwen2API (Bun/Node) — see README.md for the
# scope of the port. The upstream project has no MIPS32 runtime, so the core
# chat path was reimplemented in Go and cross-compiled as a static binary.

START=96
STOP=10
USE_PROCD=1

PROG=/opt/qwen2api/qwen2api
CONF=/opt/qwen2api/qwen2api.conf

start_service() {
	# Load operator settings. Kept outside the init script so the API key is not
	# duplicated into /etc/init.d on every edit.
	if [ -f "$CONF" ]; then
		. "$CONF"
	fi
	: "${SERVICE_PORT:=3000}"
	: "${LOG_LEVEL:=INFO}"

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		SERVICE_PORT="$SERVICE_PORT" \
		API_KEY="$API_KEY" \
		LOG_LEVEL="$LOG_LEVEL" \
		ACCOUNTS_FILE=/opt/qwen2api/accounts.txt \
		TZ=CST-8
	# Restart on crash, but back off if it dies immediately and repeatedly.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd signals the instance itself; nothing extra to clean up.
	:
}

status_service() {
	procd_running "qwen2api"
}
